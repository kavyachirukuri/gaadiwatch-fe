# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:4000

# Multi-tenant: subdomains of this domain are tenant sites
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_DEFAULT_TENANT=gaadiwatch

# Real maps (Google Maps JavaScript API). Leave empty to show the simple map preview.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (DEMO_MAP_ID works for testing)
NEXT_PUBLIC_GOOGLE_MAP_ID=
